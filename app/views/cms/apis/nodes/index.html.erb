<% if try(:turbo_frame) %>
  <%= render "search", **local_assigns %>

  <form method="dialog">
    <%= render "index", **local_assigns %>
  </form>
<% else %>
  <%= jquery do %>
    SS_SearchUI.modal();
  <% end %>

  <%= render "search", **local_assigns %>
  <%= render "index", **local_assigns %>
<% end %>
