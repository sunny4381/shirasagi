<% if try(:turbo_frame) %>
  <%= render "tabs", **local_assigns %>
  <%= render "search", **local_assigns %>
  <form method="dialog" id="<%= try(:turbo_frame) %>-form">
    <%= render "index", **local_assigns %>
  </form>
<% else %>
  <turbo-frame id="modal-frame">
    <%= jquery do %>
      SS_SearchUI.modal();
    <% end %>

    <%= render "tabs", **local_assigns %>

    <%= render "search", **local_assigns %>

    <%= render "index", **local_assigns %>
  </turbo-frame>
<% end %>
