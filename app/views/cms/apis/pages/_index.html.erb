<table class="index">
  <thead class="list-head">
    <tr>
      <% unless try(:turbo_frame) %>
        <% if @multi %>
        <th class="checkbox"><input type="checkbox" /></th>
        <% end %>
      <% end %>
      <th class="name"><%= @model.t :name %></th>
      <th class="filename"><%= @model.t :filename %></th>
      <th class="state"><%= @model.t :state %></th>
      <th class="updated"><%= @model.t :updated %></th>
    </tr>
  </thead>
  <tbody class="items">
    <% @items.each do |item| %>
      <tr data-id="<%= item.id %>" data-name="<%= item.name %>" data-filename="<%= item.filename %>" data-url="<%= item.url %>" class="list-item">
        <% if try(:turbo_frame) %>
          <td class="name">
            <label>
              <%=
                value = { id: item.id, name: item.name, filename: item.filename, url: item.url }.to_json
                @multi ? checkbox_tag("ids[]", value, false, id: nil) : radio_button_tag("ids[]", value, false, id: nil, data: { controller: "ss--submit-on-change" })
              %>
              <%= item.name %>
            </label>
          </td>
        <% else %>
          <% if @multi %>
          <td class="checkbox">
            <input type="checkbox" name="ids[]" value="<%= item.id %>" />
          </td>
          <% end %>
          <td class="name"><%= link_to item.name, "#", class: @multi ? "select-item" : "select-single-item" %></td>
        <% end %>
        <td class="filename"><%= item.filename %></td>
        <td class="state"><%= colored_state_label(item) %></td>
        <td class="updated"><%= ss_time_tag(item.updated) %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<div class="search-ui-select">
  <%= button_tag t("cms.apis.pages.select"), { type: :submit, class: "select-items btn" } %>
</div>

<%= paginate @items if @items.try(:current_page) %>
