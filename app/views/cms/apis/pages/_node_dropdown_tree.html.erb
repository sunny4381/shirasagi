<%
  page_params = {}
  page_params[:id] = @selected_node.try(:id).to_i
  page_params[:root_items] = @parent_nodes.map(&:id) if @parent_nodes.present?
%>
<%= jquery do %>
  var $form = $("form.search");
  $form.on("click", ".ss-tree-item", function() {
    var $treeItem = $(this);
    var nodeId = $treeItem.data("node-id");

    $form.find("[name='s[node]']").val(nodeId);
    $form[0].requestSubmit();

    return false;
  });
<% end %>

<dt><%= t("cms.node") %></dt>
<dd>
  <%= f.hidden_field("node", value: @selected_node.try(:id)) %>
  <button class="btn" type="button" id="cms-apis-pages-node-dropdown-btn" popovertarget="cms-apis-pages-node-dropdown-popover">
    <%= @selected_node ? @selected_node.name : @cur_site.name %>
    <span class="caret">&#x25BC;</span>
  </button>
  <div popover="manual" id="cms-apis-pages-node-dropdown-popover">
    <%=
      data = { controller: "ss--tree", "current_node_id" => @selected_node.try(:id) }
      tag.turbo_frame id: "cms-nodes-tree-frame", src: cms_frames_nodes_trees_path, loading: "lazy", data: data do
        loading
      end
    %>
  </div>
</dd>
