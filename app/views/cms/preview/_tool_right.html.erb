<%
  show_path ||= nil
  if @cur_date.min < 30
    preview_date = @cur_date.change(min: 0, sec: 0)
  else
    preview_date = @cur_date.change(min: 30, sec: 0)
  end
%>

<div class="ss-preview-wrap-row ss-preview-btn-group">
  <label for="ss-preview-date"><%= t("cms.preview_date") %></label>
  <%# jquery datetimepicker は Shadow DOM に未対応のため、ブラウザ標準のものを使用する %>
  <%# ss_datetime_field_tag "ss-preview-date", @cur_date, { inside_parent: true }, { id: "ss-preview-date", class: "ss-preview-date" } %>
  <%= text_field_tag "ss-preview-date", preview_date.strftime("%Y-%m-%dT%H:%M"), type: "datetime-local", id: "ss-preview-date", class: "ss-preview-date", step: 1800, data: { "cms--preview--main-target" => "previewDate" } %>
  <%= button_tag t("cms.preview_page"), name: nil, type: :button, class: "btn ss-preview-btn-outline ss-preview-btn-pc", data: { action: "cms--preview--main#previewPc" } %>
</div>

<div class="ss-preview-wrap-row">
  <% if desktop_pc %>
    <div class="ss-preview-btn-group ss-preview-part-group ss-preview-hide">
      <select name="ss-preview-part-list" class="ss-preview-part-list">
        <option value=""><%= t("cms.part") %></option>
      </select>
      <%= button_tag t("ss.buttons.edit"), name: nil, type: :button, class: "btn ss-preview-btn-outline ss-preview-btn-edit-part", data: { action: "cms--preview--main#openPartEdit" } %>
    </div>
    <div class="ss-preview-btn-group ss-preview-hide">
      <%= link_to t("cms.layout"), "#", class: "btn ss-preview-btn-outline ss-preview-btn-edit-layout", target: "_blank", rel: "noopener", data: { "cms--preview--main-target" => "layoutEdit" } %>
    </div>
  <% end %>
  <% if show_path %>
    <div class="ss-preview-btn-group">
      <%= link_to t("ss.links.back_to_administration"), show_path, class: "btn ss-preview-btn-outline ss-preview-btn-open-path", target: "_blank", rel: "noopener" %>
    </div>
  <% end %>
</div>
