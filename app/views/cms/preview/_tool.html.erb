<%
  cms_form = nil
  request_path = SS.request_path(request)
%>
<% head_for(self) do %>
  <%# アイコンフォントは Light DOM 側で読み込む必要がある %>
  <%# Light DOM 側の CSS を汚染するかもしれないがこの位置で読み込む %>
  <%= stylesheet_link_tag("material_icons", media: "all") %>
  <%= javascript_include_tag("application") %>
<% end %>
<% foot_for(self) do %>
<% end %>

<div id="ss-preview-shadow-outer" data-controller="cms--preview--outer">
  <template shadowrootmode="open">
    <%= stylesheet_link_tag("application", media: "all") %>
    <%= stylesheet_link_tag("ss/style", media: "all") %>
    <%= stylesheet_link_tag("cms/preview", media: "all") %>

    <div id="ss-preview-shadow-root" data-controller="cms--preview--main">
      <script type="application/json" data-cms--preview--main-target="option">
        <%==
          option = {
            form_id: "ss-preview-inplace-item-form",
            page_route: (rendered[:page] || rendered[:node]).route.to_json
          }
          if rendered
            option[:item] = {}
            option[:item][:type] = rendered[:type]
            if rendered[:layout]
              option[:item][:layoutId] = rendered[:layout].id
            end
            if rendered[:node]
              option[:item][:nodeId] = rendered[:node].id
            end
            if rendered[:page]
              option[:item][:pageId] = rendered[:page].id
              if rendered[:page].respond_to?(:form)
                cms_form = rendered[:page].form
                if cms_form
                  option[:item][:formId] = cms_form.id
                  option[:item][:formSubType] = cms_form.sub_type
                end
              end
            end
          end
          option[:previewPathTemplate] = {}
          option[:previewPathTemplate][:pc] = cms_preview_path(preview_date: "$YYYYMMDDHHmmss", path: params[:path])
          if @preview_page
            option[:request_path] = request_path
            option[:form_item] = @preview_item
          end
          if mode == :preview && rendered
            if %i[page].include?(rendered[:type])
              option[:inplaceFormPath] = {}
              option[:inplaceFormPath][:page] = edit_cms_apis_preview_inplace_edit_page_path(site: @cur_site, preview_date: params[:preview_date], id: ":id")
              option[:inplaceFormPath][:columnValue] = {}
              option[:inplaceFormPath][:columnValue][:new] = "#{new_cms_apis_preview_inplace_edit_page_column_value_path(site: @cur_site, preview_date: params[:preview_date], page_id: ":pageId")}?column_id=:columnId"
              option[:inplaceFormPath][:columnValue][:edit] = edit_cms_apis_preview_inplace_edit_page_column_value_path(site: @cur_site, preview_date: params[:preview_date], page_id: ":pageId", id: ":id")
              option[:inplaceFormPath][:columnValue][:destroy] = cms_apis_preview_inplace_edit_page_column_value_path(site: @cur_site, preview_date: params[:preview_date], page_id: ":pageId", id: ":id")
              option[:inplaceFormPath][:columnValue][:moveUp] = move_up_cms_apis_preview_inplace_edit_page_column_value_path(site: @cur_site, preview_date: params[:preview_date], page_id: ":pageId", id: ":id")
              option[:inplaceFormPath][:columnValue][:moveDown] = move_down_cms_apis_preview_inplace_edit_page_column_value_path(site: @cur_site, preview_date: params[:preview_date], page_id: ":pageId", id: ":id")
              option[:inplaceFormPath][:columnValue][:moveAt] = move_at_cms_apis_preview_inplace_edit_page_column_value_path(site: @cur_site, preview_date: params[:preview_date], page_id: ":pageId", id: ":id")
              option[:inplaceFormPath][:palette] = palette_cms_apis_preview_inplace_edit_form_path(site: @cur_site, preview_date: params[:preview_date], id: ":id")
              option[:publishPath] = publish_cms_apis_preview_page_path(site: @cur_site, preview_date: params[:preview_date], id: rendered[:page])
              option[:lockPath] = lock_cms_apis_preview_page_path(site: @cur_site, preview_date: params[:preview_date], id: rendered[:page], format: :json)
            elsif %i[node].include?(rendered[:type])
              option[:publishPath] = publish_cms_apis_preview_node_path(site: @cur_site, preview_date: params[:preview_date], cid: rendered[:node])
            end

            option[:workflowPath] = {}
            option[:workflowPath][:wizard] = cms_apis_preview_workflow_wizard_path(site: @cur_site, preview_date: params[:preview_date], id: ":id")
            option[:workflowPath][:pages] = "/.s#{@cur_site.id}/workflow/pages/:id"
            option[:workflowPath][:request] = request_path
            option[:previewPath] = cms_preview_path(path: ":path")
            option[:redirectorPath] = {}
            option[:redirectorPath][:newPage] = new_page_cms_apis_preview_node_path(site: @cur_site, cid: ":nodeId")

            option[:userInplaceEdit] = inplace_editable?
          end

          option.to_json
        %>
      </script>

      <% if params[:action] == "form_preview" %>
        <div id="ss-preview" style="position: relative;">
          <div class="ss-preview-wrap">
              <div class="ss-preview-wrap-column ss-preview-wrap-column-title-wrap">
                  <div id="ss-preview-title"><%= t("cms.preview_page2") %></div>
              </div>
          </div>
          <div class="ss-preview-notice-wrap hide" data-controller="cms--preview--notice" data-cms--preview--main-target="notice"></div>
        </div>
      <% else %>
        <div id="ss-preview">
          <div class="ss-preview-wrap">
            <% left = render "tool_left", local_assigns %>
            <% if left.present? %>
              <div class="ss-preview-wrap-column ss-preview-wrap-column-edit-mode">
                <%= left %>
              </div>
            <% end %>
            <% right = render "tool_right", local_assigns %>
            <% if right.present? %>
              <div class="ss-preview-wrap-column ss-preview-wrap-column-mode-change">
                <%= right %>
              </div>
            <% end %>
          </div>
          <div class="ss-preview-notice-wrap hide" data-controller="cms--preview--notice" data-cms--preview--main-target="notice"></div>
        </div>
      <% end %>

      <%= render "link_errors", local_assigns %>
    </div> <!-- #ss-preview-shadow-root -->
  </template>
</div> <!-- #ss-preview-shadow-outer -->
